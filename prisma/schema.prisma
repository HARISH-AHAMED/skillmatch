datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  COMPANY
  FREELANCER
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  /// Unpublished work-in-progress; owner-only, never publicly browseable.
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CLOSED
  /// Company intentionally dropped the project. History stays readable.
  CANCELLED
  /// Removed from the active list. History stays intact.
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  REJECTED
  HIRED
}

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String?   @unique
  emailVerified          DateTime?
  image                  String?
  role                   Role      @default(FREELANCER)
  /// bcrypt digest. Historically this column held plaintext (SEC-002); values
  /// are upgraded in place on the owner's next successful login.
  passwordHash           String?
  /// Set when a credential was migrated from legacy plaintext storage, so the
  /// user can be prompted to choose a new password they know was never stored
  /// in the clear.
  passwordChangeRequired Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  freelancerProfile Freelancer?
  companyProfile    Company?
  notifications     Notification[]
  reviewsWritten    Review[]        @relation("ReviewsWritten")
  reviewsReceived   Review[]        @relation("ReviewsReceived")
  adminLogs         AdminLog[]
  messages          Message[]
  sharedFiles       SharedFile[]
  projectUpdates    ProjectUpdate[]
  assignedTasks     Task[]          @relation("AssignedTasks")
  createdTasks      Task[]          @relation("CreatedTasks")
  meetingsOrganized Meeting[]
  meetingAttendance MeetingAttendee[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Freelancer {
  id                String   @id @default(cuid())
  userId            String   @unique
  bio               String?  @db.Text
  skills            String[] // Array of lowercase skills for indexing
  experienceYears   Int      @default(0)
  portfolioUrl      String?
  /// Profile banner image. Null on every profile created before this existed.
  bannerUrl         String?
  resumeUrl         String?
  rating            Float    @default(0.0)
  completedProjects Int      @default(0)
  completionRate    Float    @default(100.0) // Percentage (0-100)

  // New fields for freelancer profile options
  domain               String?  @default("Other")
  professionalHeadline String?
  experience           Json? // Array of Experience objects: { id, title, company, startDate, endDate, current, description }
  certifications       Json? // Array of Certification objects: { id, name, issuer, year }
  portfolioItems       Json? // Array of PortfolioItem objects: { id, title, description, type, url, fileUrl }
  responseTime         String?  @default("Within 24 hours")
  availabilityStatus   String?  @default("AVAILABLE") // AVAILABLE, BUSY, UNAVAILABLE
  gender               String?  @default("ANY")
  verificationBadges   String[] @default([])

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications     Application[]
  recommendations  Recommendation[]
  savedByCompanies SavedFreelancer[]
  savedProjects    SavedProject[]
  certificates     Certificate[]
}

model Company {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyName     String
  description     String?  @db.Text
  industry        String?
  website         String?
  location        String?
  bannerUrl       String?  @default("")
  officeLocations String[] @default([])

  // New fields for extended Company Profile page
  logoUrl            String?  @default("")
  companySize        String?  @default("10-50 employees")
  foundedYear        Int?     @default(2020)
  linkedin           String?  @default("")
  email              String?  @default("")
  phone              String?  @default("")
  missionVision      String?  @default("") @db.Text
  workCulture        String?  @default("") @db.Text
  hiringPhilosophy   String?  @default("") @db.Text
  galleryPhotos      String[] @default([])
  galleryVideos      String[] @default([])
  benefits           String[] @default([])
  teamMembers        Json?    @default("[]") // Array of { name, role, photoUrl }
  verificationBadges String[] @default([]) // e.g. ["Identity Verified", "Business Verified", ...]
  trustScore         Int      @default(90)
  reputationScore    Int      @default(90)
  sentimentAnalysis  String?  @default("") @db.Text
  completionRate     Float    @default(100.0)
  retentionRate      Float    @default(100.0)
  paymentReliability Float    @default(100.0)
  avgResponseTime    String?  @default("Within 24 hours")
  avgTimeToHire      String?  @default("14 days")
  hiringSuccessRate  Float    @default(100.0)
  followers          String[] @default([]) // User IDs of followers
  watchlistUsers     String[] @default([]) // User IDs watchlisting
  talentCommunity    String[] @default([]) // User IDs in talent community
  jobAlertsUsers     String[] @default([]) // User IDs subscribed to job alerts

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects         Project[]
  savedFreelancers SavedFreelancer[]
  certificates     Certificate[]
}

model SavedFreelancer {
  id           String   @id @default(cuid())
  companyId    String
  freelancerId String
  savedAt      DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([companyId, freelancerId])
  @@index([freelancerId])
}

model Project {
  id                 String          @id @default(cuid())
  companyId          String
  title              String
  description        String          @db.Text
  budget             Float
  priority           ProjectPriority @default(MEDIUM)
  requiredSkills     String[]
  experienceRequired Int             @default(0)
  status             ProjectStatus   @default(OPEN)
  freelancersLimit   Int             @default(1)
  isVisible          Boolean         @default(true)
  domain             String?         @default("Other")
  bannerUrl          String?
  preferredGender    String?         @default("ANY")
  dueDate            DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications       Application[]
  recommendations    Recommendation[]
  reviews            Review[]
  savedByFreelancers SavedProject[]
  roles              ProjectRole[]
  messages           Message[]
  sharedFiles        SharedFile[]
  projectUpdates     ProjectUpdate[]
  tasks              Task[]
  certificates       Certificate[]

  meetings            Meeting[]
  compensation        ProjectCompensation?
  paymentItems        PaymentItem[]
  workLogs            WorkLog[]
  stipendPeriods      StipendPeriod[]
  paymentTransactions PaymentTransaction[]

  @@index([companyId])
  @@index([status])
}

model Application {
  id              String            @id @default(cuid())
  projectId       String
  freelancerId    String
  /// Which role slot this application targets. Null for listings posted before
  /// roles existed, or for projects that do not use them.
  roleId          String?
  /// Applying as an apprentice (shadowing) rather than as the primary hire.
  isApprentice    Boolean           @default(false)
  /// Set when the freelancer confirms after seeing the assembled team.
  teamConfirmedAt DateTime?
  coverLetter     String            @db.Text
  aiScore         Float             @default(0.0)
  status          ApplicationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer Freelancer   @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  role       ProjectRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  paymentItems   PaymentItem[]
  workLogs       WorkLog[]
  stipendPeriods StipendPeriod[]

  @@unique([projectId, freelancerId])
  @@index([freelancerId])
  @@index([status])
  @@index([roleId])
}

model Recommendation {
  id           String   @id @default(cuid())
  projectId    String
  freelancerId String
  score        Float
  createdAt    DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([projectId, freelancerId])
  @@index([freelancerId])
}

model Review {
  id         String   @id @default(cuid())
  projectId  String
  reviewerId String
  revieweeId String
  rating     Int // 1 to 5
  comment    String   @db.Text
  createdAt  DateTime @default(now())

  // New sub-scores for company reviews by freelancers
  communicationScore      Int?
  paymentReliabilityScore Int?
  projectClarityScore     Int?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([reviewerId])
  @@index([revieweeId])
}

model SavedProject {
  id           String   @id @default(cuid())
  freelancerId String
  projectId    String
  savedAt      DateTime @default(now())

  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, projectId])
  @@index([projectId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  senderId  String
  content   String   @db.Text
  channel   String   @default("group") // "group", "freelancers", or "dm:userId1:userId2"
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([senderId])
}

model SharedFile {
  id           String   @id @default(cuid())
  projectId    String
  uploadedById String
  fileName     String
  fileUrl      String   @db.Text
  fileSize     String?
  channel      String   @default("group") // "group", "freelancers", or "dm:userId1:userId2"
  uploadedAt   DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([uploadedById])
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String
  createdById String
  title       String
  description String   @db.Text
  status      String // e.g. "PENDING", "IN_PROGRESS", "COMPLETED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdById])
}

model Task {
  id           String    @id @default(cuid())
  projectId    String
  title        String
  description  String?   @db.Text
  status       String    @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  dueDate      DateTime?
  assignedToId String? // User ID of the assigned user
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User    @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assignedToId])
  @@index([createdById])
}

/// A platform-issued, publicly verifiable credential awarded to a freelancer for
/// completed work. Distinct from the self-reported entries in
/// Freelancer.certifications JSON — this one is issued by a company, tied to a real
/// project, and resolvable at /verify/{publicId} so a third party can confirm it.
model Certificate {
  id            String    @id @default(cuid())
  /// Short, human-shareable code shown on the certificate and used in the verify URL.
  publicId      String    @unique
  projectId     String
  freelancerId  String
  companyId     String
  /// Snapshot of the details at issue time. Deliberately denormalised: a certificate
  /// must keep saying what it said when issued, even if the project or profile changes.
  roleTitle     String
  skills        String[]  @default([])
  durationText  String?
  summary       String?   @db.Text
  issuerName    String
  recipientName String
  projectTitle  String
  issuedAt      DateTime  @default(now())
  /// Optional co-signers. Null on certificates issued before two-signer support,
  /// which continue to render from issuerName alone.
  signer1Name         String?
  signer1Title        String?
  signer1SignatureUrl String?
  signer2Name         String?
  signer2Title        String?
  signer2SignatureUrl String?
  /// Revocation keeps the record for auditability rather than deleting it.
  revokedAt     DateTime?
  revokeReason  String?

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([projectId, freelancerId])
  @@index([freelancerId])
  @@index([companyId])
  @@index([publicId])
}

/// A named position on a project with a fixed number of openings, e.g.
/// "2 × Frontend Developer". Optional by design: a project with no roles keeps
/// the original one-candidate-per-listing behaviour untouched.
model ProjectRole {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  description     String?  @db.Text
  /// How many people are wanted in this role.
  slots           Int      @default(1)
  /// Whether a junior may shadow this role (apprentice programme).
  allowApprentice Boolean  @default(false)
  /// Display order in the wizard and applicant review tabs.
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Financial model — see FINANCIAL_ARCHITECTURE_PLAN.md
//
// Replaces the JSON-in-a-text-column storage that ARCH-001 identified: payment
// stages, funding, releases, work logs and stipend payouts were all serialized
// into Project.description, mutated with an unsynchronised read-modify-write.
//
// Amounts are Decimal(18,2), never Float (DATA-004), and every amount is stored
// with the currency it is denominated in (DATA-003).
// ─────────────────────────────────────────────────────────────────────────────

enum CompensationTypeEnum {
  FIXED
  HOURLY
  MILESTONE
  STIPEND
  UNPAID
}

enum StipendFrequencyEnum {
  ONE_TIME
  WEEKLY
  MONTHLY
}

enum PaymentItemStatus {
  PENDING
  FUNDED
  SUBMITTED
  /// Sent back for changes. Distinct from PENDING so a rejected submission is
  /// not indistinguishable from one that was never made (COMP-004).
  CHANGES_REQUESTED
  APPROVED
  RELEASED
  CANCELLED
}

enum WorkLogStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerEntryType {
  FUND
  RELEASE
  REFUND
  ADJUSTMENT
}

/// DATA-002 — the single source of truth for how a project pays. Replaces the
/// four unsynchronised representations (compensationType, paymentCategory,
/// stipendType, offerLetter.paymentCategory).
model ProjectCompensation {
  id               String               @id @default(cuid())
  projectId        String               @unique
  type             CompensationTypeEnum
  currency         String
  totalBudget      Decimal              @db.Decimal(18, 2)
  budgetNegotiable Boolean              @default(false)

  hourlyRate     Decimal? @db.Decimal(18, 2)
  /// COMP-006 — now enforceable rather than decorative.
  estimatedHours Int?
  maxHours       Int?

  stipendAmount    Decimal?              @db.Decimal(18, 2)
  stipendFrequency StipendFrequencyEnum?
  /// COMP-013 — bounds the number of payable periods.
  stipendPeriods   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// COMP-010 + WS-003 — one table replacing all five milestone representations:
/// paymentStages, digitalContract.milestones, escrowMilestones (dead),
/// offerLetter.milestones, and the ProjectUpdate "[Value: $X]" title regex.
model PaymentItem {
  id            String            @id @default(cuid())
  projectId     String
  /// Required. Every financial record is attributed to exactly one hired
  /// application, which closes COMP-002 and MF-003 structurally rather than by
  /// a runtime check.
  applicationId String
  title         String
  description   String?           @db.Text
  sortOrder     Int               @default(0)
  amount        Decimal           @db.Decimal(18, 2)
  currency      String
  status        PaymentItemStatus @default(PENDING)
  dueDate       DateTime?         @db.Date

  /// Caches over the ledger, written in the same transaction as the ledger
  /// entry. PaymentTransaction remains authoritative.
  fundedAmount   Decimal @default(0) @db.Decimal(18, 2)
  releasedAmount Decimal @default(0) @db.Decimal(18, 2)

  submissionNote String?   @db.Text
  reviewNote     String?   @db.Text
  revisionCount  Int       @default(0)
  submittedAt    DateTime?
  reviewedAt     DateTime?
  releasedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ledger      PaymentTransaction[]

  @@index([projectId])
  @@index([applicationId])
  @@index([projectId, status])
}

/// COMP-007 — rateSnapshot freezes the rate in force when the work was logged,
/// so editing the project rate no longer retroactively reprices approved work.
model WorkLog {
  id            String        @id @default(cuid())
  projectId     String
  applicationId String
  /// TIME-002 — date-only, so a date-picker value cannot shift a day across
  /// timezones.
  workDate      DateTime      @db.Date
  hours         Decimal       @db.Decimal(6, 2)
  description   String        @db.Text
  status        WorkLogStatus @default(PENDING)
  rateSnapshot  Decimal       @db.Decimal(18, 2)
  currency      String
  reviewedAt    DateTime?
  reviewedById  String?
  /// COMP-008 — a reason on rejection, so a mistaken rejection is explicable.
  reviewNote    String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// COMP-009 — duplicate-date guard at the database level.
  @@unique([applicationId, workDate, description])
  @@index([projectId])
  @@index([applicationId, status])
}

/// COMP-013 / COMP-015 — periods are enumerable and bounded, and a period can
/// be paid exactly once, enforced by the database rather than an array scan.
model StipendPeriod {
  id            String            @id @default(cuid())
  projectId     String
  applicationId String
  periodIndex   Int
  periodStart   DateTime?         @db.Date
  periodEnd     DateTime?         @db.Date
  amount        Decimal           @db.Decimal(18, 2)
  currency      String
  status        PaymentItemStatus @default(PENDING)
  releasedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, periodIndex])
  @@index([projectId])
}

/// ARCH-001 — append-only ledger. Every movement of value is a row here. Never
/// updated, never deleted; a correction is a new compensating entry.
model PaymentTransaction {
  id              String          @id @default(cuid())
  projectId       String
  applicationId   String
  paymentItemId   String?
  workLogId       String?
  stipendPeriodId String?
  type            LedgerEntryType
  /// Signed: FUND positive, RELEASE negative, REFUND positive.
  amount          Decimal         @db.Decimal(18, 2)
  currency        String
  actorUserId     String
  note            String?         @db.Text

  /// Replay protection. A retried or double-clicked mutation reuses the same
  /// key and is rejected by the unique index rather than creating a second
  /// movement — closing the double-release race that a status check alone
  /// cannot, because that check reads state a concurrent transaction is
  /// changing.
  idempotencyKey String @unique

  /// Payment-provider reference. Null under the internal-ledger-only scope
  /// (COMP-001 deferred); present if a provider is integrated later, so that
  /// work needs no schema change.
  externalRef String?

  createdAt DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paymentItem PaymentItem? @relation(fields: [paymentItemId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([applicationId])
  @@index([paymentItemId])
}

enum MeetingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum MeetingAttendeeStatus {
  INVITED
  ACCEPTED
  DECLINED
}

/// Workspace meetings. Scoped to a project so membership — and therefore
/// visibility — is derived from the same project-party rules everything else
/// in the workspace uses.
model Meeting {
  id              String        @id @default(cuid())
  projectId       String
  /// The user who scheduled it; always a member of the owning company.
  organizerUserId String
  title           String
  description     String?       @db.Text
  startsAt        DateTime
  durationMinutes Int           @default(30)
  /// Either a joining link or a physical location; both optional.
  meetingUrl      String?
  location        String?
  status          MeetingStatus @default(SCHEDULED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizer User              @relation(fields: [organizerUserId], references: [id], onDelete: Cascade)
  attendees MeetingAttendee[]

  @@index([projectId])
  @@index([projectId, startsAt])
}

model MeetingAttendee {
  id        String                @id @default(cuid())
  meetingId String
  userId    String
  status    MeetingAttendeeStatus @default(INVITED)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}
